# ZelionDash sensor overrides
#
# Copy to /WIDGETS/ZelionDash/sensors.cfg on the radio's storage.
# Everything here is OPTIONAL - sensor discovery is automatic. Use this file
# only when your model publishes a sensor under a name the widget does not
# recognise, or when auto-detection picked the wrong one.
#
# Format:   role = SensorName
# Sections: [*]           applies to everything
#           [Model Name]  the EdgeTX model slot, and wins over [*]
#           [cells:N]     an aircraft identified only by its cell count, for a
#                         flight controller that publishes no name
#           [Craft Name]  what the FLIGHT CONTROLLER calls the aircraft, from
#                         RF Tool, and wins over all of them
#           Section names are matched case-insensitively.
#
# The craft section is for a radio set up with ONE EdgeTX model flying several
# helicopters, keeping the configuration on the aircraft instead of duplicating
# it across model slots. Under that setup the model name is a constant and says
# nothing about what is flying, so name the section after the helicopter as the
# Rotorflight configurator knows it:
#
#   [ALZRC Devil 380]
#   escTemperature = Tmp1
#
# It is applied the moment the flight controller reports a different craft, so
# swapping helicopters on one model slot rebinds without touching the radio.
#
# WHEN THE FLIGHT CONTROLLER WILL NOT SAY. Rotorflight reports a craft name.
# OMPHOBBY's OSF03 has no provision for one, so those aircraft arrive anonymous
# - and on one model slot, anonymous means indistinguishable. What they do
# bring is a cell count, and a fleet whose unnamed aircraft differ in cells is
# separable by it:
#
#   [cells:3]
#   craftName = Omphobby M2 V3
#
#   [cells:2]
#   craftName = Omphobby M1 V3
#
# craftName is the one key here that is not a role binding: it is what to call
# the aircraft, and it is written to the flight log. A cells section takes role
# overrides like any other.
#
# A reported craft name always beats a cell count, because a name is a fact and
# a count is an inference - which is what separates two aircraft that share a
# cell count but report different names.
#
# A line naming a role that does not exist is reported on the diagnostics
# screen rather than ignored, so typos are visible.
#
# The right-hand side may also be "off", which leaves the role unbound and
# stops the widget guessing at it:
#
#   throttle = off
#
# That is the answer to a wrong (guess) on the sensor map. Naming a different
# sensor does NOT work when the sensor you want does not exist - a name the
# firmware does not know falls through to the same guess that was wrong.
#
# The guess is narrower than it was. A sensor that any role knows by name is
# never handed to a different role as a guess: TQly is a link-quality sensor
# and the widget knows it, so throttle no longer picks it up on a flight
# controller that publishes no Thr. What "off" still refuses is a guess at a
# percent sensor the widget has never heard of.
#
# Switching a role off is a decision, not a gap: the sensor map shows it as
# "off" and it is not counted among the unresolved sensors.

[*]
# --- rotor ---
# headspeed        = Hspd
# tailSpeed        = Tspd

# --- battery ---
# packVoltage      = Vbat
# cellVoltage      = Vcel
# cellCount        = Cel#
# batteryPercent   = Bat%
# capacity         = Capa
# batteryProfile   = BAT#

# --- power ---
# current          = Curr
# power            = Pwr
# becVoltage       = Vbec

# --- temperatures ---
# escTemperature   = Tesc
# mcuTemperature   = Tmcu

# --- flight controller ---
# governor         = Gov
# armFlags         = ARM
# throttle         = Thr      (or "off" - see above, ExpressLRS has no Thr)
# flightMode       = FM

# --- radio link ---
# linkQuality      = RQly
# rssi1            = 1RSS
# rssi2            = 2RSS
# txVoltage        = tx-voltage


# Example of a per-model override:
#
# [Goblin 700]
# escTemperature = Tmp1
#
# Settings can be scoped exactly like the bindings above. Writing one inside
# [battery] applies it to the whole radio, which is usually what a pack setting
# means; writing the same key inside [*], a model, a [cells:N] or a craft
# section applies it to that aircraft and nothing else, with the most specific
# winning. See "scoping a setting" at the end of this file.


# ---------------------------------------------------------------------------
# [battery] - settings, not sensor bindings
# ---------------------------------------------------------------------------
#
# These matter ONLY when the widget has to work out the battery percentage
# itself. On Rotorflight it never does: the flight controller computes the
# state of charge - the "Smart Fuel" feature - and publishes it as the Bat%
# sensor, which the widget reads directly. Smart Fuel has the pack's history,
# a sag model and the stick positions, and a widget has none of those, so its
# answer always wins.
#
# If your percentage looks wrong on a Rotorflight heli, the fix is in the
# flight controller, not here: set Smart Fuel's mode on the Rotorflight
# configurator's Smart Fuel page.
#
#   OFF        nothing is computed
#   VOLTAGE    from sag-compensated cell voltage
#   CURRENT    from consumed capacity, so it assumes a full pack at power-on
#   COMBINED   the lower of the two - the conservative reading, and usually
#              the one you want on a heli
#
# When Bat% is absent - a non-Rotorflight flight controller, or Smart Fuel OFF
# - the widget derives the percentage from cell voltage using Rotorflight's own
# VOLTAGE-mode curve, so both setups report the same number for the same pack.
# These two values are that curve's endpoints, and match Rotorflight's stock
# vbat_min_cell_voltage / vbat_full_cell_voltage. Change them only for a
# chemistry that is not a standard LiPo.
#
# [battery]
# cellFull = 4.00
# cellMin  = 3.30
#
# --- alert thresholds ---
#
# alertCell is the voltage you want to HEAR about, not the voltage the pack
# dies at. It fires once when a cell reaches it, repeats every 15 seconds while
# it stays there, and re-arms only once the pack recovers 0.10V above it - so a
# cell sagging across the line under load does not announce itself on every
# rotor beat. The reading is spoken through the radio's own voice, so there is
# no sound file to install.
#
# alertEsc works the same way, clearing 8 degrees below the trigger. Its
# default comes from the aircraft profile rather than being one number for
# every helicopter - 110 on a big ESC, 90 on a 200-size one in a tight canopy.
# Setting it here overrides the profile, for either aircraft.
#
# alertCell has no profile default: a LiPo cell is in trouble at 3.40 V whether
# it is one of two or one of fourteen.
#
# Alerts can be switched off entirely in the widget settings, and ENTER on the
# sensor map sounds one on demand - so checking that the buzzer and the voice
# work does not mean editing a threshold here and editing it back afterwards.
#
# [battery]
# alertCell = 3.40
# alertEsc  = 110
#
# --- time remaining ---
#
# How much pack the time-remaining estimate treats as untouchable. The timer
# reaches zero when the pack reaches this, not when it is flat. 0 means fly it
# to empty, which is a choice rather than a default.
#
# [battery]
# reservePct = 20


# ---------------------------------------------------------------------------
# SCOPING A SETTING TO ONE AIRCRAFT
# ---------------------------------------------------------------------------
#
# The five [battery] settings can be written in any section, and resolve down
# the same chain the sensor bindings use:
#
#   [battery]  ->  [*]  ->  [model]  ->  [cells:N]  ->  [craft]
#
# most specific last. [battery] is the base, so a fleet that wants one number
# everywhere keeps writing exactly what it wrote before.
#
# reservePct is the one that needed this. Calibrated against where a pilot
# actually lands - rested cell voltage against the percentage the pack was at -
# a 6S 2200 and a 2S micro do not agree: the same 3.80 V rested is about 45% on
# one and about 41% on the other. A single radio-wide figure is short on one
# helicopter or early on the other, and the midpoint is both.
#
#   [battery]
#   reservePct = 40          # everything, unless something below says otherwise
#
#   [ALZRC Devil 380]
#   reservePct = 45          # this helicopter only, by the name its FC reports
#
#   [cells:2]
#   reservePct = 41          # the 2S micro, which has no name to go by
#
# A setting written against an aircraft also counts as explicitly set, so an
# aircraft profile will not overrule it - the same rule [battery] has always
# had, now applying at whatever scope it was written.
#
# The sensor map's CONFIG row counts these like any other override, so a
# section carrying nothing but a reserve still shows up as having applied.
